{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "首页"
      }
    },
    {
      "path": "pages/forum/list",
      "style": {
        "navigationBarTitleText": "社区论坛"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  },
  "tabBar": {
    "color": "#333",
    "selectedColor": "#2f6bff",
    "backgroundColor": "#fff",
    "borderStyle": "white",
    "list": [
      {
        "text": "首页",
        "pagePath": "pages/index/index",
        "iconPath": "static/tabs/home_default.png",
        "selectedIconPath": "static/tabs/home_selected.png"
      },
      {
        "text": "论坛",
        "pagePath": "pages/forum/list",
        "iconPath": "static/tabs/forum_default.png",
        "selectedIconPath": "static/tabs/forum_selected.png"
      },
      {
        "text": "我的",
        "pagePath": "pages/profile/index",
        "iconPath": "static/tabs/user_default.png",
        "selectedIconPath": "static/tabs/user_selected.png"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue",
      "^van-(.*)": "@vant/weapp/dist/$1/index",
      "^Xtx(.*)": "@/components/Xtx$1.vue"
    }
  },
  "subPackages": [
    {
      "root": "pagesRecruit",
      "pages": [
        {
          "path": "detail/detail",
          "style": { "navigationBarTitleText": "详情" }
        },
        {
          "path": "publish/publish",
          "style": { "navigationBarTitleText": "发布招新" }
        },
        {
          "path": "mine/mine",
          "style": { "navigationBarTitleText": "我的发布" }
        }
      ]
    },
    {
      "root": "pagesForum",
      "pages": [
        {
          "path": "detail/detail",
          "style": { "navigationBarTitleText": "帖子详情" }
        },
        {
          "path": "post/post",
          "style": { "navigationBarTitleText": "发帖" }
        }
      ]
    },
    {
      "root": "pagesResume",
      "pages": [
        {
          "path": "edit/edit",
          "style": { "navigationBarTitleText": "我的简历" }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pagesRecruit"]
    }
  }
}
